<?xml version="1.0" encoding="utf-8"?>
<!-- INTERNET is declared for ONE purpose: downloading sonnet narration
     when the reader asks for it (js/narration.js). The bundle ships
     without the 212.9MB of readings, so without this they could never be
     fetched at all.

     Everything else is served from the APK through WebViewAssetLoader and
     makes no network call. The app has no accounts, no analytics and no
     telemetry, so the Play data-safety declaration stays simple and true:
     nothing is collected, nothing is sent, and the only outbound request
     is for audio the user explicitly asked to keep.

     Hard constraint 3 was amended for this on 2026-10-04 by the owner's
     explicit decision — see CLAUDE.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Speechcraft"
        android:supportsRtl="true"
        android:theme="@style/Theme.Speechcraft">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
