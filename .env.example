# Copy to .env (which is gitignored) or export these in your shell.
# Used ONLY by the offline generation tools in tools/ — never by the app.
#
# The deployed site contains no API code path and needs no key at all.

# ElevenLabs key for tools/generate_sonnets.py and tools/generate_voices.py.
# Create it with "Restrict Key" ON and only these permissions:
#   - Text to Speech (access)
#   - Voices (read)
# Alternatively write it to tools/.elevenlabs_key (also gitignored, chmod 600).
ELEVENLABS_API_KEY=
